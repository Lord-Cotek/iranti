{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json", "eslint.config.mjs"],
  "globalEnv": ["NODE_ENV", "VERCEL_ENV", "VERCEL_GIT_COMMIT_SHA"],
  "globalPassThroughEnv": [
    "NODE_EXTRA_CA_CERTS",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY",
    "https_proxy",
    "http_proxy",
    "no_proxy",
    "CI",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "env": [
        "AUTH_SECRET",
        "AUTH_URL",
        "CAPACITOR_ORIGINS",
        "DATABASE_URL",
        "DIRECT_URL",
        "EMAIL_FROM",
        "NEXT_PUBLIC_*",
        "R2_*",
        "RESEND_API_KEY",
        "VERCEL",
        "WEB_ORIGIN"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"]
    },
    "lint": {
      "dependsOn": ["generate"]
    },
    "test": {
      "dependsOn": ["generate"],
      "outputs": ["coverage/**"],
      "env": ["TEST_DATABASE_URL"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["E2E_DATABASE_URL", "NEXT_PUBLIC_*"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["generate"],
      "cache": false,
      "persistent": true
    }
  }
}
