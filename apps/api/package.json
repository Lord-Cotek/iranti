{
  "name": "@iranti/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API: Next.js route handlers only. Database, auth, jobs and integrations.",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@iranti/core": "workspace:*",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "19.2.18",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
