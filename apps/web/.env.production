# Public, non-secret build-time values for the static client. Committed on purpose so the
# Vercel web project needs no environment variables. Never put a secret in a NEXT_PUBLIC_*
# variable: it is inlined into the shipped JavaScript.
NEXT_PUBLIC_SITE_URL=https://iranti.cotek.app
NEXT_PUBLIC_API_URL=https://api.iranti.cotek.app
