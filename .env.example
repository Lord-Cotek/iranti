# ─────────────────────────────────────────────────────────────────────────────
# Ìrántí environment variables (BUILD.md §18)
#
# Two Vercel projects, two sets of variables:
#   iranti-web  (apps/web, iranti.cotek.app)      → only NEXT_PUBLIC_* (already
#               committed in apps/web/.env.production; nothing to set in Vercel)
#   iranti-api  (apps/api, api.iranti.cotek.app)  → everything else
#
# Non-secret API defaults (AUTH_URL, WEB_ORIGIN, CAPACITOR_ORIGINS) are committed
# in apps/api/.env.production. Secrets are set in Vercel → Project → Settings →
# Environment Variables, never committed. Never log any of these values.
#
# "Phase N" = first phase that reads the variable. Leave later ones unset for now.
# ─────────────────────────────────────────────────────────────────────────────

# ── API: core ────────────────────────────────────────────────────────────────
# Phase 0. Neon POOLED connection string (host contains "-pooler"). Runtime queries.
# If you add Neon through the Vercel Marketplace, it creates DATABASE_URL for you.
DATABASE_URL=
# Phase 0. Neon DIRECT (unpooled) connection string. Prisma migrations only.
# The Vercel Neon integration names this DATABASE_URL_UNPOOLED: copy its value here.
DIRECT_URL=
# Phase 1. Better Auth signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=
# Public base URL of the API (committed default in apps/api/.env.production).
AUTH_URL=https://api.iranti.cotek.app
# The web origin allowed to call the API with cookies (exact match, no wildcard).
WEB_ORIGIN=https://iranti.cotek.app
# Capacitor webview origins allowed to call the API with bearer tokens.
CAPACITOR_ORIGINS=capacitor://localhost,https://localhost

# ── Storage: encrypted blobs only (Phase 1) ──────────────────────────────────
# Cloudflare → R2 → Manage API tokens. Token scoped to this one bucket, Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=iranti-vault

# ── KMS: protects only Ìrántí's key pieces (Phase 3) ─────────────────────────
# Choose one provider (BUILD.md §19.2). A piece opens nothing on its own.
AWS_REGION=
AWS_KMS_KEY_ID_PIECES=
# IAM user/role for the API, allowed kms:Encrypt/Decrypt on that key only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# GCP alternative:
# GCP_KMS_KEY_PIECES=projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>
# GCP_SERVICE_ACCOUNT_JSON=

# ── Timelock: drand (Phase 4) ────────────────────────────────────────────────
# drand quicknet (3 s rounds, unchained, BLS12-381). Verify before Phase 4.
DRAND_CHAIN_URL=https://api.drand.sh/52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971

# ── Jobs and messaging ───────────────────────────────────────────────────────
# Phase 2. Trigger.dev project secret key (tr_prod_…).
TRIGGER_SECRET_KEY=
# Phase 1. Resend API key; sending domain verified for cotek.app.
RESEND_API_KEY=
# Phase 1. From address for OTP and notices, e.g. "Ìrántí <hello@iranti.cotek.app>".
EMAIL_FROM=
# Phase 3/5. SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Phase 5. WhatsApp Cloud API.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── AI: Ìtàn (Phase 6) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_HARD=claude-opus-5-5

# ── Monitoring (Phase 1) ─────────────────────────────────────────────────────
# Scrubbed with an allow-list; never on vault screens.
SENTRY_DSN=

# ── Web (public, inlined into the static bundle: never put a secret here) ────
NEXT_PUBLIC_API_URL=https://api.iranti.cotek.app
NEXT_PUBLIC_SITE_URL=https://iranti.cotek.app
